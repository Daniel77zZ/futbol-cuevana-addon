# Copy to .env on the droplet and fill in. `.env` is gitignored (repo .gitignore
# lines 49-51), so the password never reaches the repository.
#
#   cp .env.example .env
#   openssl rand -hex 24        # paste the result into API_PASSWORD below

# Protects MediaFlow from being used as an open proxy. Never leave this unset on
# a public host: the same value also goes into the Worker secret
# MEDIAFLOW_API_PASSWORD.
API_PASSWORD=

# The hostname Caddy serves and requests a certificate for.
# No domain of your own? Use the droplet IP in sslip.io form:
#   MEDIAFLOW_DOMAIN=203.0.113.10.sslip.io
# With a domain you control, point an A record at the droplet and use it here:
#   MEDIAFLOW_DOMAIN=mediaflow.example.com
MEDIAFLOW_DOMAIN=
